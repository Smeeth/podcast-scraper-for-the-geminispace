#
# EditorConfig configuration to enforce consistent code styling across IDEs
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,json5,jsonc,yaml,yml,toml,ini,cfg,conf}]
indent_style = space
indent_size = 2

[*.{html,css,js,mjs,ts}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{gmi,gophermap}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[{Dockerfile,docker-compose*.yml}]
indent_style = space
indent_size = 2

[*.{sh,bash}]
indent_style = space
indent_size = 4
end_of_line = lf

[*.{ps1,bat,cmd}]
indent_style = space
indent_size = 4
