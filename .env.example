# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Standard Docker-Compose PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/podcast_researcher

# Für lokale Entwicklung außerhalb von Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/podcast_researcher
# Für SQLite Fallback (lokale Tests):
# DATABASE_URL=sqlite+aiosqlite:///./podcast_researcher.db

# ==============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# ==============================================================================
# Hinterlege hier deinen offiziellen Google Gemini API Key:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# APPLICATION & SECURITY SETTINGS
# ==============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
MAX_EPISODES_PER_IMPORT=100
REQUEST_TIMEOUT_SECONDS=30
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
