#
# Git Ignore Configuration (Security First - ADR-0001)

# ==============================================================================
# 1. Secrets & Environment Variables (ADR-0001: Zero Secrets in Version Control)
# ==============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
*.secret

# ==============================================================================
# 2. Python Runtime, Bytecode & Build Artifacts
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ==============================================================================
# 3. Virtual Environments
# ==============================================================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.ENV/
/.venv/
/venv/
/env/
/bin/
/include/
/Lib/
/Scripts/
!.github/scripts/

# ==============================================================================
# 4. Databases, Local Storage & Docker Persistence
# ==============================================================================
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
podcast_researcher.db
pgdata/
postgres-data/
postgres_data/
appdata/
data/

# ==============================================================================
# 5. Testing, Quality Assurance, Linting & Coverage
# ==============================================================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json
*.cover
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ==============================================================================
# 6. Scraper Caches, Downloads & Temporary Files
# ==============================================================================
*.log
logs/
tmp/
temp/
*.tmp
*.temp
.yt-dlp/
*.part
*.ytdl
*.aria2
downloads/

# ==============================================================================
# 7. IDE, Editor & OS Artifacts
# ==============================================================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log
*.swp
*.swo
*~
*.bak
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==============================================================================
# 8. Dynamic Geminispace & Gopherspace Published Files (Preserve Index Templates)
# ==============================================================================
# Dynamisch generierte Podcast-Dateien ignorieren, aber Basis-Index behalten
public/gemini/*.gmi
!public/gemini/index.gmi
public/gopher/*
!public/gopher/gophermap
